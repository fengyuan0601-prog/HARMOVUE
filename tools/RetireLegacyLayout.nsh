!ifndef LOCALMEDIA_RETIRE_LEGACY_LAYOUT
!define LOCALMEDIA_RETIRE_LEGACY_LAYOUT

!ifndef LEGACY_LOOSE_INCLUDE
 !error "The exact legacy cleanup list must be generated by tools/Compile-Installer.ps1."
!endif

; Only retire known old bytes after the new payload is in place. Unrelated
; paths, modified files, reparse points and unavailable files remain untouched.
Function LocalMediaRetireMatchingFile
 IfFileExists "$R0" 0 lm_retire_skip
 StrCpy $LocalMediaCheckedPath $R0
 Call LocalMediaCheckPath
 StrCmp $LocalMediaPathSafe 1 0 lm_retire_skip
 Push "$R0"
 Call LocalMediaNativeSHA256
 Pop $R2
 StrCmp $R2 "$R1" 0 lm_retire_skip
 Delete "$R0"
 lm_retire_skip:
FunctionEnd

Function LocalMediaRetireLegacyLayout
 Push $R0
 Push $R1
 Push $R2
 ReadRegStr $R0 HKCU "Software\LocalMedia" "InstallDir"
 StrCmp $R0 "$INSTDIR" 0 lm_legacy_done
 ReadRegStr $R0 HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\LocalMedia" "DisplayVersion"
 StrCmp $R0 "1.0.2" 0 lm_legacy_done
 !include "${LEGACY_LOOSE_INCLUDE}"
 lm_legacy_done:
 Pop $R2
 Pop $R1
 Pop $R0
FunctionEnd
!endif
