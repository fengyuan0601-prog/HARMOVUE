Unicode true
; SPDX-License-Identifier: GPL-3.0-or-later
; Configure compression before includes that embed the System plugin.
SetCompressor zlib
SetCompress off
AllowSkipFiles off
!include "MUI2.nsh"
!include "KeepIdenticalNative.nsh"
!ifndef APP_VERSION
 !define APP_VERSION "1.0.5"
!endif
!ifndef PAYLOAD_DIR
 !define PAYLOAD_DIR "..\release\portable"
!endif
!ifndef PREFLIGHT_INCLUDE
 !error "Use tools/Compile-Installer.ps1 to generate checks for the exact payload."
!endif
!ifndef UNINSTALL_INCLUDE
 !error "The exact payload uninstall allowlist must be generated by tools/Compile-Installer.ps1."
!endif
!ifndef UNINSTALL_PREFLIGHT_INCLUDE
 !error "Uninstall preflight must be generated by tools/Compile-Installer.ps1."
!endif
!include "InstallPreflight.nsh"
!include "InstallTargetSafety.nsh"
!include "RetireLegacyLayout.nsh"
Name "HARMOVUE"
Icon "..\brand\assets\icon\harmovue-app.ico"
UninstallIcon "..\brand\assets\icon\harmovue-app.ico"
!ifdef INSTALLER_OUTFILE
 OutFile "${INSTALLER_OUTFILE}"
!else
 OutFile "..\release\HARMOVUE-${APP_VERSION}-win-x64-Setup.exe"
!endif
InstallDir "E:\Codex\Programs\LocalMedia"
!ifndef LOCALMEDIA_TEST_INSTALLER
InstallDirRegKey HKCU "Software\LocalMedia" "InstallDir"
!endif
RequestExecutionLevel user
!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "SimpChinese"
Section "HARMOVUE"
 Call LocalMediaValidateInstallDirectory
 Call LocalMediaCheckTargetReady
 StrCmp $InstallCheckOnly 1 0 +3
 SetErrorLevel 0
 Quit
 SetOutPath "$INSTDIR"
 File /r /x libmpv-2.dll /x e_sqlite3.dll "${PAYLOAD_DIR}\*.*"
 !insertmacro KeepIdenticalNative "${PAYLOAD_DIR}\libmpv-2.dll" "libmpv-2.dll" "${MPV_SHA256}"
 !insertmacro KeepIdenticalNative "${PAYLOAD_DIR}\e_sqlite3.dll" "e_sqlite3.dll" "${SQLITE_SHA256}"
!ifndef LOCALMEDIA_TEST_INSTALLER
 Call LocalMediaRetireLegacyLayout
 WriteRegStr HKCU "Software\LocalMedia" "InstallDir" "$INSTDIR"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\LocalMedia" "DisplayName" "HARMOVUE ${APP_VERSION}"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\LocalMedia" "DisplayVersion" "${APP_VERSION}"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\LocalMedia" "UninstallString" '"$INSTDIR\Uninstall.exe"'
 WriteRegStr HKCU "Software\Classes\LocalMedia.Media" "" "HARMOVUE 本地影音"
 WriteRegStr HKCU "Software\Classes\LocalMedia.Media\shell\open\command" "" '"$INSTDIR\LocalMedia.exe" "%1"'
 WriteRegStr HKCU "Software\Classes\Applications\LocalMedia.exe\shell\open\command" "" '"$INSTDIR\LocalMedia.exe" "%1"'
 Delete "$INSTDIR\LocalMedia.lnk"
 CreateShortCut "$INSTDIR\HARMOVUE.lnk" "$INSTDIR\LocalMedia.exe"
 CreateShortCut "$DESKTOP\HARMOVUE.lnk" "$INSTDIR\LocalMedia.exe"
 CreateDirectory "$SMPROGRAMS\HARMOVUE"
 CreateShortCut "$SMPROGRAMS\HARMOVUE\HARMOVUE.lnk" "$INSTDIR\LocalMedia.exe"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\LocalMedia" "DisplayIcon" "$INSTDIR\LocalMedia.exe"
 WriteRegStr HKCU "Software\RegisteredApplications" "HARMOVUE" "Software\LocalMedia\Capabilities"
 WriteRegStr HKCU "Software\LocalMedia\Capabilities" "ApplicationName" "HARMOVUE"
 WriteRegStr HKCU "Software\LocalMedia\Capabilities" "ApplicationDescription" "本地音乐与视频播放器"
 WriteRegStr HKCU "Software\Classes\LocalMedia.Media\DefaultIcon" "" '"$INSTDIR\LocalMedia.exe",0'
 WriteRegStr HKCU "Software\Classes\.mp3\OpenWithProgids" "LocalMedia.Media" ""
 WriteRegStr HKCU "Software\Classes\Applications\LocalMedia.exe\SupportedTypes" ".mp3" ""
 WriteRegStr HKCU "Software\LocalMedia\Capabilities\FileAssociations" ".mp3" "LocalMedia.Media"
