 WriteRegStr HKCU "Software\Classes\.m2ts\OpenWithProgids" "LocalMedia.Media" ""
 WriteRegStr HKCU "Software\Classes\Applications\LocalMedia.exe\SupportedTypes" ".m2ts" ""
 WriteRegStr HKCU "Software\LocalMedia\Capabilities\FileAssociations" ".m2ts" "LocalMedia.Media"
