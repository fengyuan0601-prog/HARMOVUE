 WriteUninstaller "$INSTDIR\Uninstall.exe"
SectionEnd
Section "Uninstall"
!ifndef LOCALMEDIA_TEST_INSTALLER
 ReadRegStr $0 HKCU "Software\LocalMedia" "InstallDir"
 StrCmp $0 $INSTDIR 0 lm_keep_other_install_shortcuts
 Delete "$DESKTOP\HARMOVUE.lnk"
 Delete "$SMPROGRAMS\HARMOVUE\HARMOVUE.lnk"
 RMDir "$SMPROGRAMS\HARMOVUE"
 lm_keep_other_install_shortcuts:
!endif
 !include "${UNINSTALL_INCLUDE}"
 Push "$INSTDIR\HARMOVUE.lnk"
 Call un.LocalMediaDeleteOwnedFile
 Push "$INSTDIR\LocalMedia.lnk"
 Call un.LocalMediaDeleteOwnedFile
 Push "$INSTDIR\Uninstall.exe"
 Call un.LocalMediaDeleteOwnedFile
 ; Unknown files, Data and media are preserved regardless of extension.
!ifndef LOCALMEDIA_TEST_INSTALLER
 ReadRegStr $0 HKCU "Software\LocalMedia" "InstallDir"
 StrCmp $0 $INSTDIR 0 lm_keep_other_install_registration
 DeleteRegValue HKCU "Software\RegisteredApplications" "HARMOVUE"
 DeleteRegValue HKCU "Software\Classes\.mp3\OpenWithProgids" "LocalMedia.Media"
 DeleteRegValue HKCU "Software\Classes\.aac\OpenWithProgids" "LocalMedia.Media"
 DeleteRegValue HKCU "Software\Classes\.m4a\OpenWithProgids" "LocalMedia.Media"
